{
  "name": "blogsphere",
  "version": "2.0.0",
  "description": "BlogSphere - a full-stack blogging platform (Express, MongoDB, vanilla JS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --forceExit",
    "migrate": "node scripts/migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "blog",
    "express",
    "mongodb"
  ],
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "sanitize-html": "^2.18.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "^10.1.0"
    }
  }
}
